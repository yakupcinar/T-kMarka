# Yerel geliştirme yapılandırması.
#
# Kiracı alan adları burada elle sayılıyor. Faz 3'te bunun yerine
# on-demand TLS gelecek: Caddy tanımadığı alan adı için uygulamaya sorar,
# 200 alırsa sertifikayı kendisi alır.
#
# Sorulacak uç 0.5/7'de YAZILDI ve çalışıyor:
#     GET /tenancy/domain-check?domain=<alan-adi>   → 200 / 404
#     (App\Http\Platform\DomainCheckController)
#
# Faz 3'te buraya eklenecek olan:
#     {
#         on_demand_tls {
#             ask http://localhost/tenancy/domain-check
#         }
#     }
#     https:// {
#         tls { on_demand }
#         ...
#     }
#
# ⚠️ `ask` olmadan on_demand ASLA açılmaz — IP'mize yönlendirilen her alan
#    adı için sertifika istenir ve Let's Encrypt kotamız yanar. (M-4.1/1)

marka-a.localhost, marka-b.localhost, localhost {

	# Let's Encrypt .localhost adreslerine sertifika veremez.
	# Caddy kendi iç otoritesiyle üretir. (M-4)
	tls internal

	# Web'e açık TEK klasör. Diğer her şey bunun dışında kalıyor.
	root * /var/www/html/public

	encode zstd gzip

	# PHP isteklerini uygulama konteynerine devret.
	# Adres KODA GÖMÜLÜ DEĞİL — ortam değişkeninden okunuyor, böylece
	# ileride FPM başka bir konteynere/pod'a taşınırsa burası değişmiyor.
	# Unix soketi değil TCP kullanılmasının sebebi de bu. (M-4)
	php_fastcgi {$FPM_HOST:app}:{$FPM_PORT:9000}

	# Statik dosyaları (görsel, css, js) Caddy kendisi sunar.
	# PHP-FPM bunu yapamaz.
	file_server

	log
}
