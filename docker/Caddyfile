# ⚠️ VEKİL GÜVENİ — Caddy'nin kendi ayarı, Laravel'inkinden AYRI.
#
# ÖLÇÜLDÜ: ngrok Caddy'ye `X-Forwarded-Proto: https` gönderiyor (erişim
# günlüğünde görünüyor), ama Caddy onu FastCGI'ye iletirken KENDİ şemasıyla
# (http) yeniden yazıyordu — çünkü gönderen taraf güvenilir sayılmıyordu.
#
# Ayar açıldıktan sonra ölçülen: scheme https · isSecure true · istemci IP
# gerçek adres (konteyner IP'si değil).
#
# Bu ayar açıkken Caddy, özel ağdan gelen isteğin `X-Forwarded-*`
# başlıklarını KORUYOR. Laravel de zaten aynı aralıklara güveniyor
# (bootstrap/app.php).
#
# Sessiz bedeli neydi: iyzico callback adresinin SSL olmasını ZORUNLU
# tutuyor. Şema http kalsaydı ödeme başlatma isteği reddedilir, müşteri
# hiçbir yere yönlendirilemez ve elimizde yalnızca "ödeme çalışmıyor"
# kalırdı.
#
# ⚠️ `private_ranges` — `0.0.0.0/0` DEĞİL. Herkese güvenilseydi, sunucuya
# doğrudan ulaşan biri kendini HTTPS'ten geliyormuş gibi gösterebilirdi.
{
	servers {
		trusted_proxies static private_ranges
	}
}

# Yerel geliştirme yapılandırması.
#
# Kiracı alan adları burada elle sayılıyor. Faz 3'te bunun yerine
# on-demand TLS gelecek: Caddy tanımadığı alan adı için uygulamaya sorar,
# 200 alırsa sertifikayı kendisi alır.
#
# Sorulacak uç 0.5/7'de YAZILDI ve çalışıyor:
#     GET /tenancy/domain-check?domain=<alan-adi>   → 200 / 404
#     (App\Http\Platform\DomainCheckController)
#
# Faz 3'te buraya eklenecek olan:
#     {
#         on_demand_tls {
#             ask http://localhost/tenancy/domain-check
#         }
#     }
#     https:// {
#         tls { on_demand }
#         ...
#     }
#
# ⚠️ `ask` olmadan on_demand ASLA açılmaz — IP'mize yönlendirilen her alan
#    adı için sertifika istenir ve Let's Encrypt kotamız yanar. (M-4.1/1)

marka-a.localhost, marka-b.localhost, localhost {

	# Let's Encrypt .localhost adreslerine sertifika veremez.
	# Caddy kendi iç otoritesiyle üretir. (M-4)
	tls internal

	# Web'e açık TEK klasör. Diğer her şey bunun dışında kalıyor.
	root * /var/www/html/public

	encode zstd gzip

	# PHP isteklerini uygulama konteynerine devret.
	# Adres KODA GÖMÜLÜ DEĞİL — ortam değişkeninden okunuyor, böylece
	# ileride FPM başka bir konteynere/pod'a taşınırsa burası değişmiyor.
	# Unix soketi değil TCP kullanılmasının sebebi de bu. (M-4)
	php_fastcgi {$FPM_HOST:app}:{$FPM_PORT:9000}

	# Statik dosyaları (görsel, css, js) Caddy kendisi sunar.
	# PHP-FPM bunu yapamaz.
	file_server

	log
}

# ── ngrok tüneli (1E-K10) — YALNIZCA HTTP ──────────────────────────────
#
# ⚠️ `http://` öneki BİLEREK: Caddy'nin otomatik HTTPS'i bu blok için
# kapanıyor. Kapanmasaydı Caddy gerçek bir alan adı görüp Let's Encrypt'ten
# sertifika istemeye kalkardı — makine dışarıdan erişilebilir olmadığı için
# doğrulama düşer ve kota yanardı (M-4.1/1).
#
# TLS'i ngrok'un kendisi sonlandırıyor: müşteri/sağlayıcı ile ngrok arası
# HTTPS, ngrok ile bizim aramız Docker ağının içi.
#
# ⚠️ Değişken TANIMSIZSA bu blok `tunel-kapali.invalid` adresine bağlanıyor
# ve hiçbir isteği yakalamıyor. Varsayılan boş bırakılsaydı Caddy blok
# adresi olmayan bir site tanımıyla açılmayı reddederdi.
http://{$NGROK_DOMAIN:tunel-kapali.invalid} {

	# ⚠️ Şema doğruluğu YUKARIDAKİ `trusted_proxies` ayarına bağlı.
	#
	# Sessiz bedeli: iyzico callback adresinin SSL olmasını ZORUNLU
	# tutuyor. Şema `http` kalsaydı ödeme başlatma isteği reddedilir,
	# müşteri hiçbir yere yönlendirilemez ve elimizde yalnızca "ödeme
	# çalışmıyor" kalırdı.

	root * /var/www/html/public
	encode zstd gzip

	php_fastcgi {$FPM_HOST:app}:{$FPM_PORT:9000}

	file_server
	log
}
