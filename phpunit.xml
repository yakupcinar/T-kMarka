<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!--
            Kiracı testleri AYRI paket. Sebep: RefreshDatabase her testi bir
            transaction'a sarıyor, ama kiracı oluşturmak CREATE SCHEMA +
            ayrı bir bağlantıda migration demek. Commit edilmemiş şemayı o
            bağlantı göremiyor ve test patlıyor.
            Bu paket transaction kullanmaz, temizliği kendisi yapar.
        -->
        <testsuite name="Tenancy">
            <directory>tests/Tenancy</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <!--
            Cache testlerde de REDIS. Laravel'in varsayılanı "array" ama o
            sürücüde veri yöneticinin İÇİNDE durur; kiracı değişince paket
            yöneticiyi değiştirdiği için veri kayboluyor ve test gerçekte
            olmayan bir hata gösteriyor.
            Ayrı Redis veritabanı (15) kullanılıyor ki geliştirme verisine
            dokunulmasın — 0.4'teki SQLite/PostgreSQL kararının aynısı.
        -->
        <env name="CACHE_STORE" value="redis" force="true"/>
        <env name="REDIS_CACHE_DB" value="15" force="true"/>
        <!--
            Testler de PostgreSQL'de koşar, SQLite'ta değil.
            Sebep: şema (kiracılık), citext, jsonb ve SELECT FOR UPDATE
            SQLite'ta yok. SQLite'ta test etmek "yeşil test, patlayan
            üretim" demek olurdu.
            Ayrı veritabanı: geliştirme verisi testlerle silinmesin.
        -->
        <!--
            force="true" ŞART. Konteynerin ortamında .env'den gelen
            DB_DATABASE=tikmarka zaten var; force olmadan phpunit onu
            EZMEZ ve testler geliştirme veritabanında koşar.
        -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <!--
            ⚠ DB_HOST ve DB_PORT bilerek force="true" DEĞİL.
            Yerelde Docker ağında sunucunun adı "postgres"; CI'da ise
            servisler aynı makinede, 127.0.0.1 üzerinden erişiliyor.
            force konsaydı CI'da yanlış adrese bağlanmaya çalışırdık.
            Değer .env'den (yerel) veya iş akışı ortamından (CI) gelir.
        -->
        <env name="DB_HOST" value="postgres"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="tikmarka_test" force="true"/>

        <!--
            ABONELİK (3E) — imza anahtarı testte DOLU olmak zorunda.
            ⚠️ Boş bırakılırsa sağlayıcı istisna fırlatıyor (1E.7'nin dersi:
            boş anahtarla imzalama geçerli GÖRÜNEN bir imza üretiyordu).
        -->
        <env name="SUBSCRIPTION_WEBHOOK_SECRET" value="test-abonelik-imza-anahtari"/>
        <env name="DB_USERNAME" value="tikmarka" force="true"/>
        <env name="DB_PASSWORD" value="secret" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <!--
            Kuyruk testleri gerçek Redis'e yazıyor (ayrı veritabanı: 14).
            "sync" olsaydı iş anında, hâlâ kiracı bağlamındayken çalışırdı ve
            asıl mekanizmayı (kimliğin işin gövdesinde taşınması) test etmezdik.
            Ayrı veritabanı: çalışan worker test işlerini kapmasın.
        -->
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="REDIS_DB" value="14" force="true"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
