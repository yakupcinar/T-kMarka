# Bağımlılıklar
/vendor
/node_modules

# Ortam ve sırlar — .env ASLA depoya girmez, .env.example girer
.env
.env.backup
.env.production
/auth.json

# Laravel çalışma zamanı
# ⚠ Kiracı klasörleri: her markanın yüklediği dosyalar buraya düşüyor
#   (storage/tenant<kimlik>/app/...). Ürün görselleri dahil — asla depoya girmez.
# Derlenmiş Blade önbelleği — DERLEME ÇIKTISI, kaynak değil.
#
# ⚠️ 4A'da fark edildi: 7 dosya depoya kaçmıştı ve her Blade değişikliğinde
# anlamsız fark üretiyorlardı. Laravel bu klasörü kendi .gitignore'uyla
# korur; bizde yoktu.
/storage/framework/views/*.php

/storage/tenant*
/storage/*.key
/storage/pail
/public/build
/public/hot
/public/storage
/bootstrap/cache/*.php

# Test ve analiz önbellekleri
/.phpunit.cache
.phpunit.result.cache
/.phpstan.cache

# Docker — Caddy sertifikaları ve veritabanı hacimleri
/docker/data
/docker/caddy

# Editör ve işletim sistemi
/.idea
/.vscode
/.zed
/.fleet
/.nova
.DS_Store
*.swp

# Loglar
npm-debug.log
yarn-error.log
