APP_NAME=TikMarka
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Kontrol düzleminin adresi (M-2.2). Kiracı alan adları `domains` tablosundan gelir.
APP_CENTRAL_DOMAIN=localhost

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Veritabanı (M-2: tek veritabanı, kiracı başına şema) ---
# Merkez şema `public`, kiracılar `tenant_*` şemalarında durur.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=tikmarka
DB_USERNAME=tikmarka
DB_PASSWORD=secret
DB_SCHEMA=public

# Test veritabanı — geliştirme verisi testlerle silinmesin (0.4)
DB_TEST_DATABASE=tikmarka_test

# --- Redis: cache + kuyruk ---
# ⚠️ Anahtar öneki kiracı bağlamında ayrıca öneklenir (M-2.4/cache)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Mail: yerelde Mailpit yakalar (0.2) ---
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="bilgi@tikmarka.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- PHP-FPM adresi (M-4) ---
# ⚠️ Kodda sabit değil, buradan okunur — konteyner ayrımına geçişte değişmesin diye.
FPM_HOST=app
FPM_PORT=9000

# --- Nesne depolama (opsiyonel, Faz 6) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Ödeme sağlayıcısı — SIR DEĞİL, yalnızca ortam adresi.
# Marka API anahtarları buraya GİRMEZ; panelden girilir ve settings'te
# şifreli saklanır (her markanın kendi hesabı var).
IYZICO_BASE_URI=https://sandbox-api.iyzipay.com

# ── ngrok tüneli — yalnızca ödeme sağlayıcısı testi için (1E-K10) ─────
# Sağlayıcı bize webhook atabilsin diye geçici genel adres. Gerçek alan
# adına geçildiğinde silinecek; kalıcı bir bağımlılık DEĞİL.
#
# ⚠️ NGROK_AUTHTOKEN bir SIRDIR — .env.example'a değeri YAZILMAZ.
# ⚠️ Tünel normal `up` ile açılmaz: docker compose --profile tunel up -d ngrok
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
