includes:
    - vendor/larastan/larastan/extension.neon

parameters:

    # Seviye 0-10. Yükseldikçe daha titiz olur.
    #
    # Plan 5 diyordu; 8'e çıkarıldı. Gerekçe: "düşükten başla" kuralı
    # mevcut kodda yüzlerce uyarı çıkmasın diye vardır — bizim kod
    # tabanımız boş ve 8'de sıfır uyarı veriyor.
    #
    # Seviye 8'in kazandırdığı asıl şey: null olabilecek değere
    # kontrolsüz erişimi yakalıyor.  User::find() bulamazsa null döner;
    # ->name yazarsan uygulama çöker. Seviye 5 bunu göremiyor.
    #
    # 9-10 (mixed tipe katı davranma) sonraya bırakıldı — Laravel'in
    # request()->input() gibi uçları doğal olarak mixed döndürüyor.
    level: 8

    paths:
        - app
        - database
        - routes
        - tests

    ignoreErrors:
        # Pest'te $this çalışma anında Tests\TestCase'e bağlanır
        # (tests/Pest.php → pest()->extend(...)). Statik analiz kodu
        # çalıştırmadan incelediği için bu bağlamayı göremiyor ve
        # $this->get() gibi Laravel test yardımcılarını tanımıyor.
        #
        # Kapsam SADECE tests/ — uygulama kodunda bu kural geçerli değil,
        # orada gerçek bir "olmayan metot" hatası yakalanmaya devam eder.
        -
            message: '#Call to an undefined method PHPUnit\\Framework\\TestCase::#'
            path: tests/*

        # tests/Pest.php'deki yardımcılar Pest'in `test()` fonksiyonunu kullanıyor;
        # o da çalışma anında test örneğini döndürüyor. Statik analiz bu bağlamayı
        # göremiyor. Kapsam TEK DOSYA — gerçek yazım hataları diğer test
        # dosyalarında yakalanmaya devam ediyor.
        -
            message: '#Call to an undefined method Pest\\#'
            path: tests/Pest.php
